#!/bin/zsh
# Mirrors the GUI.Forms web-host and PlaySuite web-port checkouts to the Mini
# (source only: no audio masters, screens, incoming packages or build folders)
# and runs a command in the PlaySuite mirror with emsdk on PATH.
#   tools/web/m4web [--sync-only] [--] <command...>
set -euo pipefail
here=${0:A:h}
games=${here:h:h}
toolkit=${GUI_FORMS_WEB:-$HOME/Developer/gui_forms-web}
host="$($HOME/.local/bin/m4host)"
remote_base='Developer/PlaysuiteDependencies/web'
sync_only=0
[[ "${1:-}" == --sync-only ]] && { sync_only=1; shift; }
[[ "${1:-}" == -- ]] && shift
common=(--exclude=.git/ --exclude=.claude/ --exclude=.build/ --exclude=/build/ --exclude=node_modules/)
ssh "$host" "mkdir -p $remote_base/gui_forms $remote_base/playsuite-games"
rsync -az --delete "${common[@]}" \
  --exclude=/third_party/skia/ --exclude=/third_party/harfbuzz/ --exclude=/third_party/freetype/ \
  --exclude=/third_party/libunibreak/ --exclude=/out/ \
  "$toolkit/" "$host:$remote_base/gui_forms/"
rsync -az --delete "${common[@]}" \
  --exclude=/incoming/ --exclude=/evidence/ --exclude=/review/ --exclude=/bee-candidates/ \
  --exclude=/new-games/ --exclude=/assets/audio/ --exclude='/*.wav' --exclude='/*.png' \
  --exclude='/[0-9]*' --exclude=screens/ --exclude=audio_src/ --exclude=/web-out/ \
  "$games/" "$host:$remote_base/playsuite-games/"
(( sync_only )) && { print "synced to $host:~/$remote_base"; exit 0; }
cmd=""
for a in "$@"; do printf -v q '%q' "$a"; cmd+="${cmd:+ }$q"; done
ssh "$host" "export PATH=/opt/homebrew/bin:\$PATH EMSDK_QUIET=1; source ~/Developer/PlaysuiteDependencies/emsdk/emsdk_env.sh >/dev/null; cd ~/$remote_base/playsuite-games && $cmd"
